{
  "mcpServers": {
    "pitwall-lab": {
      "command": "python3",
      "args": [
        "tools/pitwall-lab-mcp/server.py"
      ]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project-from-cwd",
        "--open-web-dashboard",
        "false"
      ]
    }
  }
}
